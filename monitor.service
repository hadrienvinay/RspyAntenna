[Unit]
Description=Ground Station Monitor Dashboard
After=network.target dump1090-fa.service

[Service]
ExecStart=/usr/bin/python3 /home/suri/monitor/monitor.py
Restart=always
RestartSec=5
User=suri
WorkingDirectory=/home/suri/monitor
# Tue tout le cgroup (rtl_fm, sox, gnss-sdr, rtl_power, dump1090…) à l'arrêt
# du service, pas seulement le PID principal — évite les process orphelins
# qui gardent le dongle RTL-SDR occupé après un stop/restart.
KillMode=control-group
TimeoutStopSec=10

[Install]
WantedBy=multi-user.target
